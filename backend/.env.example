APP_ENV=development
SECRET_KEY=change-me
CORS_ORIGINS=*

# sqlite or mysql
DB_BACKEND=sqlite
SQLITE_PATH=data/app.db

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=heartanalysis
MYSQL_USER=root
MYSQL_PASSWORD=

# AI provider: rules, llama_cpp, or openai
AI_PROVIDER=llama_cpp

# llama.cpp local server (recommended)
LLAMA_CPP_MODEL=local-model
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
LLAMA_CPP_TIMEOUT_SECONDS=60

# OpenAI-compatible remote option
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20

# API safety controls
MAX_REQUEST_SIZE_KB=256
AI_RATE_LIMIT_PER_MINUTE=30
